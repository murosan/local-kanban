FROM golang:1.26-alpine

WORKDIR /app

# Install git & build tools & golangci-lint v2 via official install script
RUN apk add --no-cache git gcc musl-dev bash curl
RUN curl -sSfL https://golangci-lint.run/install.sh | sh -s -- -b $(go env GOPATH)/bin

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

EXPOSE 3737

ENV PORT=3737
ENV HOST=0.0.0.0
ENV TASKS_DIR=/app/tasks

CMD ["go", "run", "./cmd/localkanban", "start"]
