		"@types/prismjs": "1.26.6",
		"@types/react-syntax-highlighter": "15.5.13",
		"@uiw/react-md-editor": "4.2.3",
		"clsx": "2.1.1",
		"lucide-react": "1.72.0",
		"marked": "18.2.0",
		"prismjs": "1.30.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"react-syntax-highlighter": "16.1.2",
		"remark-gfm": "4.0.1",
		"tailwind-merge": "3.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@tailwindcss/postcss": "4.3.5",
